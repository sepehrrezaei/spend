app.*.symbols

# Obfuscation related
app.*.map.json

# Your ledger is yours. These patterns exist so a stray backup or a copy of the
# live database can never be committed by accident.
*.spendbak
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Note on generated code: lib/data/db/database.g.dart IS committed, so a fresh
# clone builds and tests without running build_runner first. Regenerate it with
# `dart run build_runner build` after changing anything under lib/data/db/.
# pubspec.lock is committed too — this is an application, not a package, and
# pinned versions make builds reproducible.

# Generated knowledge graph (graphify) — rebuildable from source
graphify-out/
